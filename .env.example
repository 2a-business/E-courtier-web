# URL publique de l'API (vide en développement : le proxy Vite redirige /api vers Django)
VITE_API_URL=
# Tuiles cartographiques : vérifiez la politique d'usage du fournisseur choisi.
# Les tuiles OpenStreetMap publiques ne conviennent pas à un trafic important.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; contributeurs OpenStreetMap
